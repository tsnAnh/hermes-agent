{
  "sync_commit": "48058f84b39fc81de234f815c2be9a480196933f",
  "runs": [
    {
      "cfg": "envelope",
      "kind": "baseline",
      "expect": "pass",
      "why": "the protocol holds under the stated assumptions; a failure here means a change broke the normal case"
    },
    {
      "cfg": "finding_lease_expiry",
      "kind": "finding",
      "expect": "violates:AtMostOnce",
      "why": "a live owner's queued dispatch outlives the pending_slot lease and a second ticker restores the same occurrence",
      "finding": "F-A"
    },
    {
      "cfg": "finding_stamp_erased",
      "kind": "finding",
      "expect": "violates:NoSilentLoss",
      "why": "a run that overlaps the next slot completes while the next tick holds its dispatch, and the completion erases that tick's pending_slot",
      "finding": "F-B"
    },
    {
      "cfg": "finding_headless_refusal",
      "kind": "finding",
      "expect": "violates:NoSilentLoss",
      "why": "a headless tick scans a stale occurrence, the scan fast-forwards next_run_at, and the gateway-down refusal then erases pending_slot",
      "finding": "F-C"
    },
    {
      "cfg": "finding_silent_collapse",
      "kind": "finding",
      "expect": "violates:NoSilentLoss",
      "why": "an occurrence that comes due while a dispatch waits for its claim is dropped by the claim's re-anchor with no log and no ledger row",
      "finding": "F-D"
    },
    {
      "cfg": "mutant_no_stamp",
      "kind": "mutant",
      "expect": "violates:NoSilentLoss",
      "why": "without the pending_slot stamp a death between advance and claim loses the occurrence"
    },
    {
      "cfg": "mutant_claim_keeps_stamp",
      "kind": "mutant",
      "expect": "violates:AtMostOnce",
      "why": "a claim that keeps pending_slot lets a restart restore and fire an occurrence that already ran"
    },
    {
      "cfg": "mutant_no_advance",
      "kind": "mutant",
      "expect": "violates:AtMostOnce",
      "why": "without the tick-time advance the same occurrence is dispatched again"
    },
    {
      "cfg": "mutant_restore_ignores_lease",
      "kind": "mutant",
      "expect": "violates:AtMostOnce",
      "why": "restoring a live owner's pending_slot dispatches the occurrence twice"
    },
    {
      "cfg": "witness_restore",
      "kind": "witness",
      "expect": "violates:WitnessRestore",
      "why": "a scan restores an orphaned pending_slot"
    },
    {
      "cfg": "witness_claim_lost",
      "kind": "witness",
      "expect": "violates:WitnessClaimLost",
      "why": "the claim-lost branch of claim_job_for_fire is reachable"
    },
    {
      "cfg": "witness_dispatch_refused",
      "kind": "witness",
      "expect": "violates:WitnessDispatchRefused",
      "why": "the already-running refusal in _submit_with_guard is reachable"
    }
  ],
